# QDAY Agglayer environment variables
# Copy this file to .env and fill in the actual values
#
# Legend: [REQUIRED] = must be set, [OPTIONAL] = can be left empty

# [REQUIRED] Deployer mnemonic phrase (12 words)
# Derives L1 accounts at path m/44'/60'/0'/0 (Hardhat uses index 0-19).
# Deployer priority: qday/deploy_parameters.json → deployerPvtKey first;
# if unset, use MNEMONIC index 0 (m/44'/60'/0'/0/0). That account signs:
#   - pre_deploy_check: fund Sequencer / Aggregator (1000 ETH each)
#   - Sepolia: deploy test POL token
#   - deploy PolygonZkEVMDeployer, Bridge, GER, AggLayerGateway,
#     RollupManager, Timelock, and create zkRollup
# Do not use a personal wallet mnemonic. The Deployer must hold enough
# ETH on the target chain (funding + gas).
MNEMONIC="your twelve word mnemonic phrase here"

# [OPTIONAL] Sequencer private key (for POL approve)
# Used by approve_sequencer_pol (deploy.sh STEP 10) to authorize the
# rollup proxy to spend Sequencer POL. If empty, falls back to MNEMONIC
# index 0 — only correct when Sequencer is that same account.
SEQ_PVT_KEY=""

# [OPTIONAL] Infura project ID (fallback when SEPOLIA_PROVIDER / MAINNET_PROVIDER are unset)
INFURA_PROJECT_ID=""

# [OPTIONAL] Etherscan API key (only needed for contract verification)
ETHERSCAN_API_KEY=""

# [REQUIRED] L1 RPC URLs
SEPOLIA_PROVIDER="https://sepolia.infura.io/v3/xxx"
MAINNET_PROVIDER="https://mainnet.infura.io/v3/xxx"
