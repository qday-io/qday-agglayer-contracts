# QDAY Agglayer environment variables
# Copy this file to .env and fill in the actual values
#
# Legend: [REQUIRED] = must be set, [OPTIONAL] = can be left empty

# [REQUIRED] Deployer mnemonic phrase (12 words)
MNEMONIC="your twelve word mnemonic phrase here"

# [OPTIONAL] Sequencer private key (for POL approve; uses MNEMONIC index 0 if left empty)
SEQ_PVT_KEY=""

# [OPTIONAL] Infura project ID
INFURA_PROJECT_ID=""

# [OPTIONAL] Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=""

# [REQUIRED] L1 RPC URLs
SEPOLIA_PROVIDER="https://sepolia.infura.io/v3/xxx"
MAINNET_PROVIDER="https://mainnet.infura.io/v3/xxx"
