# QDAY Agglayer environment variables
# Copy this file to .env and fill in the actual values
#
# Legend: [REQUIRED] = must be set, [OPTIONAL] = can be left empty
#
# Deployer key is NOT set here. Fill deployerPvtKey in BOTH
# qday/deploy_parameters.json and qday/create_rollup_parameters.json
# (same key, manually). That account signs:
#   - pre_deploy_check: fund Sequencer / Aggregator (1000 ETH each)
#   - Sepolia: deploy test POL token
#   - deploy PolygonZkEVMDeployer, Bridge, GER, AggLayerGateway,
#     RollupManager, Timelock, and create zkRollup
# The Deployer must hold enough ETH on the target chain (funding + gas).

# [REQUIRED] Sequencer private key (for POL approve)
# Used by approve_sequencer_pol (deploy.sh STEP 9) to authorize the
# rollup proxy to spend Sequencer POL. The derived address must match
# create_rollup_parameters.json → trustedSequencer.
SEQ_PVT_KEY=""

# [OPTIONAL] Infura project ID (fallback when SEPOLIA_PROVIDER / MAINNET_PROVIDER are unset)
INFURA_PROJECT_ID=""

# [OPTIONAL] Etherscan API key (only needed for contract verification)
ETHERSCAN_API_KEY=""

# [REQUIRED] L1 RPC URLs
SEPOLIA_PROVIDER="https://sepolia.infura.io/v3/xxx"
MAINNET_PROVIDER="https://mainnet.infura.io/v3/xxx"
